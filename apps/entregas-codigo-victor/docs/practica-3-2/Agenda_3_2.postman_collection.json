      }
    },
    {
      "name": "Consultar último evento",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{modulo}}/api/practica/agenda/eventos/{{ultimo_evento}}"
      }
