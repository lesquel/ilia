          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{id_evento}}\",\n  \"correlation_id\": \"{{correlation_id}}\",\n  \"tipo\": \"tarea.fecha_modificada\",\n  \"prioridad\": \"normal\",\n  \"datos\": {\n    \"tarea_id\": {{tarea_id}},\n    \"fecha_nueva\": \"{{fecha_actual}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{modulo}}/api/practica/agenda/eventos"
      }
    },
    {
      "name": "P6 · Sin campo obligatorio",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"id_evento\", pm.variables.replaceIn(\"{{$guid}}\"));",
              "pm.variables.set(\"correlation_id\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));"
