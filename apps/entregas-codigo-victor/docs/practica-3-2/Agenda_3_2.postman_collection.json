              "pm.collectionVariables.set(\"ultimo_evento\", data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrf_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{id_evento}}\",\n  \"correlation_id\": \"{{correlation_id}}\",\n  \"tipo\": \"entrega.registrada\",\n  \"prioridad\": \"normal\",\n  \"datos\": {\n    \"tarea_id\": {{tarea_id}},\n    \"entrega_id\": {{entrega_id}}\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{modulo}}/api/practica/agenda/eventos"
      }
    },
    {
