# Añadir al .env de Laravel; no reemplazar APP_KEY ni la conexión existente.
ILIA_API_URL=http://localhost:8000/api/v1
ILIA_MODULE_SHARED_SECRET=
ILIA_PRACTICE_ENABLED=true
# API Python: ILIA_CODE_MODULE_SHARED_SECRET=<misma clave independiente>
# Expo apps/mobile/.env.local: EXPO_PUBLIC_CODE_MODULE_AUTH_MODE=ilia
