# Single source of truth for the lab deployment (5 laptops, one LAN).
# Copy to `deploy/lab/lab.env` on EVERY laptop and keep it identical: each
# node reads only the values it needs, but they must agree across nodes.
# Do not commit lab.env. Avoid spaces, quotes and `@ : / # $` in passwords:
# the DB password is embedded in a URL.

# --- Node addresses (set the real LAN IPs of each laptop) ------------------
LB_IP=192.168.1.10
FRONTEND_IP=192.168.1.11
BACKEND_IP=192.168.1.12
DB_IP=192.168.1.13
FILES_IP=192.168.1.14
# Only this subnet may reach PostgreSQL (pg_hba + ufw on the Ubuntu node).
LAB_SUBNET=192.168.1.0/24

# --- Database (Ubuntu Server node) -----------------------------------------
POSTGRES_USER=ilia
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=ilia

# --- Sessions --------------------------------------------------------------
# Same value on both API replicas, or a token signed by one is rejected by the
# other. Minimum 32 bytes. Generate: openssl rand -hex 32
ILIA_JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# --- Object storage (MinIO node) -------------------------------------------
# These are also MinIO's root credentials. Secret: at least 8 characters.
ILIA_STORAGE_ACCESS_KEY=iliaminio
ILIA_STORAGE_SECRET_KEY=change-me-minio-secret
ILIA_STORAGE_BUCKET=ilia

# --- LLM provider (optional) -----------------------------------------------
# Empty = local stub that grades nothing. Allowed: anthropic | openai | gemini
# | deepseek | openai-compatible. A named provider with an empty key refuses
# to start, so fill the key first.
ILIA_LLM_PROVIDER=
ILIA_LLM_API_KEY=
ILIA_LLM_MODEL=
ILIA_LLM_BASE_URL=
