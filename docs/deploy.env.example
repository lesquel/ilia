# Copiá este archivo a `.env` en la raíz y completá los valores.
# `docker compose` lo lee solo. Nada de esto va al repositorio.
#
# Después de `docker compose up -d --build`, el catálogo está vacío hasta:
#   docker compose run --rm api python -m scripts.seed_catalog
# Eso publica prompting-para-docentes, notebooklm-en-el-aula y
# evaluacion-asistida-por-ia. No crea contraseñas. `scripts.seed_demo` es solo
# local y se niega en producción.

# --- Base de datos ---------------------------------------------------------
POSTGRES_USER=ilia
POSTGRES_PASSWORD=            # obligatorio, sin default a propósito
POSTGRES_DB=ilia
# El host es `db`: el nombre del servicio dentro de la red de compose.
ILIA_DATABASE_URL=postgresql+asyncpg://ilia:CAMBIAME@db:5432/ilia

# --- Sesiones --------------------------------------------------------------
# Mínimo 32 bytes. La app se niega a arrancar en producción con menos, o con
# el valor por defecto de desarrollo.
ILIA_JWT_SECRET=

# El cliente web y la API tienen que compartir UN dominio registrable. La
# sesión web es cookie httpOnly con SameSite=lax: el navegador no la manda
# entre sitios distintos. Hostnames de ejemplo, no de producción. No hay
# host elegido todavía.
#
#   web  → https://ilia.example
#   api  → https://api.ilia.example
#
# Mismo host para los dos (un reverse proxy): dejá ILIA_COOKIE_DOMAIN vacío
# (cookie host-only). Subdominios distintos: el punto inicial es el dominio
# registrable, para que la cookie viaje entre ellos.

# Origen exacto del cliente web (esquema + host + puerto). JSON, no lista
# separada por comas. Tiene que coincidir con lo que el navegador muestra;
# CORS no admite comodines cuando hay credentials.
ILIA_CORS_ORIGINS=["https://ilia.example"]

# Vacío = host-only. Subdominios del mismo registrable: .ilia.example
ILIA_COOKIE_DOMAIN=.ilia.example

# Compose fija ILIA_COOKIE_SECURE=true. Las cookies se llaman ilia_session
# (path /) e ilia_refresh (solo /api/v1/auth/refresh).

# --- Proveedor de LLM ------------------------------------------------------
# Vacío corre el stub local, que NO evalúa nada. Esas notas no son reales
# y no sirven para certificar. El motor que corre es `RunEvaluation`
# (Python sobre puertos). No es LangGraph.
#
# Cómo se prueba, sin llamar a un proveedor de pago:
#   curl -sS http://localhost:${API_PORT:-8000}/health/ready
# El campo `llm` tiene que ser un nombre de proveedor, no `local-stub`.
#
# ILIA_LLM_PROVIDER — uno de:
#   anthropic           default ILIA_LLM_MODEL=claude-sonnet-4-5
#   openai              default ILIA_LLM_MODEL=gpt-4o-mini
#   gemini              default ILIA_LLM_MODEL=gemini-2.0-flash
#   deepseek            default ILIA_LLM_MODEL=deepseek-chat
#   openai-compatible   exige ILIA_LLM_MODEL e ILIA_LLM_BASE_URL
#
# La clave vive solo en `.env`, nunca en git. Un proveedor nombrado sin
# clave falla al arrancar, no en la primera entrega.
ILIA_LLM_PROVIDER=
ILIA_LLM_API_KEY=
ILIA_LLM_MODEL=               # opcional salvo openai-compatible
ILIA_LLM_BASE_URL=            # obligatorio para openai-compatible

# Precio del modelo que elegiste, para el reporte de costos del admin. En cero
# el reporte dice «sin precios configurados» en vez de inventar un número.
ILIA_LLM_INPUT_PRICE_PER_MILLION=0
ILIA_LLM_OUTPUT_PRICE_PER_MILLION=0

# --- Almacenamiento --------------------------------------------------------
# Obligatorio en producción: el adaptador local no firma nada y sirve por la
# API. La aplicación se niega a arrancar con él.
# `s3` cubre AWS, Cloudflare R2, MinIO, DigitalOcean Spaces y Backblaze B2.
ILIA_STORAGE_PROVIDER=s3
ILIA_STORAGE_BUCKET=
ILIA_STORAGE_REGION=us-east-1
ILIA_STORAGE_ACCESS_KEY=
ILIA_STORAGE_SECRET_KEY=
ILIA_STORAGE_ENDPOINT=        # vacío = AWS; completalo para R2/MinIO/Spaces

# --- Cliente web -----------------------------------------------------------
# URL de la API. Compose la pasa al Dockerfile como ARG: Expo la hornea en el
# bundle al construir la imagen. Cambiarla implica reconstruir
# (`docker compose up -d --build`). Un .env nuevo no alcanza.
EXPO_PUBLIC_API_URL=https://api.ilia.example

# Smoke, en el navegador, contra esos hosts (no contra este archivo):
#   1. registrarse     POST /api/v1/auth/register
#   2. iniciar sesión  POST /api/v1/auth/login
#   3. pedir el perfil GET  /api/v1/auth/me
# Application → Cookies: ilia_session e ilia_refresh, las dos HttpOnly.
# Application → Local Storage: sin access_token ni refresh_token. El cuerpo
# de login/register en web trae solo el perfil.

# --- Puertos publicados ----------------------------------------------------
API_PORT=8000
WEB_PORT=8080
