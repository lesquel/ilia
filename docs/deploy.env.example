# Copiá este archivo a `.env` en la raíz y completá los valores.
# `docker compose` lo lee solo. Nada de esto va al repositorio.
#
# Topología del piloto: **mismo host** (edge en WEB_PORT). Media en MinIO
# (puerto 9000). Después de `docker compose up -d --build`, el catálogo
# está vacío hasta:
#   docker compose run --rm api python -m scripts.seed_catalog

# --- Base de datos ---------------------------------------------------------
POSTGRES_USER=ilia
POSTGRES_PASSWORD=            # obligatorio, sin default a propósito
POSTGRES_DB=ilia
# El host es `db`: el nombre del servicio dentro de la red de compose.
ILIA_DATABASE_URL=postgresql+asyncpg://ilia:CAMBIAME@db:5432/ilia

# --- Sesiones (mismo host) -------------------------------------------------
# Mínimo 32 bytes.
ILIA_JWT_SECRET=

# --- One-time first-admin provisioning -------------------------------------
# These values are used only when an operator explicitly runs `make create-admin`.
# The command refuses production, never runs at API startup, and never prints the
# password. Do not commit real credentials to this file or to version control.
ILIA_BOOTSTRAP_ADMIN_EMAIL=
ILIA_BOOTSTRAP_ADMIN_NAME=
ILIA_BOOTSTRAP_ADMIN_PASSWORD=

# Decidido para la primera charla: web y API detrás del mismo origin
# (`edge`). Cookie host-only → ILIA_COOKIE_DOMAIN vacío.
#
# Local HTTP (este archivo):
ILIA_ENVIRONMENT=staging
ILIA_COOKIE_SECURE=false
ILIA_CORS_ORIGINS=["http://localhost:8080"]
ILIA_COOKIE_DOMAIN=
EXPO_PUBLIC_API_URL=http://localhost:8080
#
# Cuando haya TLS en el edge (HTTPS real), cambiá a:
#   ILIA_ENVIRONMENT=production
#   ILIA_COOKIE_SECURE=true
#   ILIA_CORS_ORIGINS=["https://TU-HOST"]
#   EXPO_PUBLIC_API_URL=https://TU-HOST
# y reconstruí la imagen web (`docker compose up -d --build`).

# Smoke, en el navegador, contra el edge (mismo host):
#   1. registrarse     POST /api/v1/auth/register
#   2. iniciar sesión  POST /api/v1/auth/login
#   3. pedir el perfil GET  /api/v1/auth/me
# Application → Cookies: ilia_session e ilia_refresh, HttpOnly.
# Application → Local Storage: sin access_token ni refresh_token.

# --- Proveedor de LLM ------------------------------------------------------
# Vacío = stub local (no certifica). El motor es `RunEvaluation`.
# Compatibles ya: anthropic | openai | gemini | deepseek | openai-compatible.
#
# Cuando tengas la clave, poné proveedor + clave (y modelo si no querés el
# default). Un proveedor nombrado sin clave **falla al arrancar**.
#
# Defaults de modelo: claude-sonnet-4-5 | gpt-4o-mini | gemini-2.0-flash |
# deepseek-chat. openai-compatible exige ILIA_LLM_MODEL e ILIA_LLM_BASE_URL.
#
# Prueba: curl -sS http://localhost:8080/health/ready
# → campo `llm` distinto de `local-stub`.
ILIA_LLM_PROVIDER=
ILIA_LLM_API_KEY=
ILIA_LLM_MODEL=
ILIA_LLM_BASE_URL=

ILIA_LLM_INPUT_PRICE_PER_MILLION=0
ILIA_LLM_OUTPUT_PRICE_PER_MILLION=0

# --- Almacenamiento (MinIO en este compose) --------------------------------
# `s3` habla S3: MinIO aquí, o AWS/R2/Spaces/B2 cambiando el endpoint.
# ILIA_STORAGE_ENDPOINT debe ser la URL que el **navegador** alcanza
# (firmas path-style). En este piloto: el puerto publicado de MinIO.
ILIA_STORAGE_PROVIDER=s3
ILIA_STORAGE_BUCKET=ilia
ILIA_STORAGE_REGION=us-east-1
ILIA_STORAGE_ACCESS_KEY=          # también es el usuario root de MinIO
ILIA_STORAGE_SECRET_KEY=          # mínimo ~8 caracteres (MinIO lo exige)
ILIA_STORAGE_ENDPOINT=http://localhost:9000

# --- Puertos publicados ----------------------------------------------------
WEB_PORT=8080          # edge: UI + /api + /health
MINIO_API_PORT=9000    # URLs firmadas de media
MINIO_CONSOLE_PORT=9001
